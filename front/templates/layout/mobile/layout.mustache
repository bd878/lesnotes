<!DOCTYPE html>
{{#html}}
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" href="/public/favicon.ico">
		<meta name="viewport" content="width=device-width,initial-scale=1" />

		{{#styles}}
			<style type="text/css">{{{styles}}}</style>
		{{/styles}}

		{{#manifest}}
			<link rel="manifest" href={{{.}}} />
		{{/manifest}}

		<title>Les Notes</title>
	</head>
	<body class="large:text-xl small:text-sm dark:bg-gray-900 dark:text-gray-400 text-gray-950">
		{{#noFixHeight}}
			<div data-is-mobile="true" class="max-w-md w-full flex flex-col items-start relative">
		{{/noFixHeight}}
		{{^noFixHeight}}
			<div data-is-mobile="true" class="h-dvh max-w-md w-full flex flex-col items-start relative">
		{{/noFixHeight}}

			<div class="small:px-3 px-5 w-full pt-5">
				{{> header}}
			</div>

			<div class="h-full w-full small:px-3 px-5 grow">
				{{> content}}
			</div>

			<div class="py-5 small:px-3 px-5 w-full">
				{{> footer}}
			</div>
		</div>

		{{#scripts}}
			<script type="module" src="{{{.}}}"></script>
		{{/scripts}}
	</body>
{{/html}}