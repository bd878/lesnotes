<div class="grow w-full flex flex-col">
	<div class="mb-5 small:mb-3 flex flex-col grow">
		<div class="grow flex flex-col w-full">
			<div class="mb-5 small:mb-3">
				{{> header}}
			</div>

			<div class="grow flex flex-col w-full">
				{{> messageHeader}}
				{{>  threadPath}}
				<div class="grow flex flex-col p-2 border border-1 border-solid rounded-md">
					{{> messageView}}
				</div>
			</div>
		</div>
	</div>

	{{#hasFeatures}}
		<div class="h-full w-full flex flex-col overflow-x-hidden">
			{{> messageFeatures}}
		</div>
	{{/hasFeatures}}
</div>