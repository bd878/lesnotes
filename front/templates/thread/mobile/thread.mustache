<div class="w-full flex flex-col">
	<div class="flex flex-col overflow-x-hidden mb-5 small:mb-3 w-full max-w-md">
		{{> header}}
	</div>

	{{#hasContent}}
		<div class="w-full grow flex flex-row mb-3">
			<div class="flex flex-col grow-2 w-full">
				{{> translations}}
				<div class="flex flex-col grow border border-1 border-solid rounded-md">
					{{> messageView}}
					{{> threadView}}
				</div>
			</div>
		</div>

		<div class="px-5 flex flex-col">
			{{> messageFeatures}}
			{{> threadFeatures}}
		</div>
	{{/hasContent}}

	<div class="mb-5 small:mb-3 ">
		{{> controlPanel}}
	</div>
</div>