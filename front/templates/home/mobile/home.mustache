<div class="h-full flex flex-col">
	<div class="flex flex-col overflow-x-hidden mb-5 small:mb-3 w-full max-w-md">
		{{> header}}
	</div>

	{{#hasMessage}}
		<div class="grow w-full flex flex-row mb-5 small:mb-3">
			<div class="flex flex-col grow-2 w-full h-full">
				{{> messageHeader}}
				<div class="flex flex-col w-full h-full overflow-x-hidden border border-1 border-solid rounded-md">
					{{> messageEditForm}}
					{{> messageView}}
					{{> newMessageForm}}
				</div>
			</div>
		</div>
	{{/hasMessage}}

	{{#hasFeatures}}
		<div class="mb-5 small:mb-3">
			{{> messageFeatures}}
		</div>
	{{/hasFeatures}}

	{{#hasMessagesTree}}
		<div class="h-0 grow mb-5 small:mb-3">
			{{> messagesTree}}
		</div>
	{{/hasMessagesTree}}

	<div class="">
		{{> controlPanel}}
	</div>
</div>