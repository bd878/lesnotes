#!/bin/bash
# 
# Builds {{ item }} service
#

set -e

HOSTS=( gallery-$ENV gallery-$ENV-4 gallery-$ENV-3 )

# env BUILD_DIR, ENV

touch "$BUILD_DIR/logs/{{ item }}.log"

echo "*** logging in $BUILD_DIR/logs/{{ item }}.log"

exec 7<&1
exec &> "$BUILD_DIR/logs/{{ item }}.log"

# build 
echo "*** building {{ item }}"

cd $BUILD_DIR/gallery/server/{{ item }}
echo "*** pwd = $(pwd)"
go version
[ $? -ne 0 ] && echo "*** go is not installed, exit." && exit 1
go env -w "CGO_ENABLED=1"
go build -v -buildvcs=false ./cmd/{{ item }}/
[ $? -ne 0 ] && echo "*** build failed, exit." && exit 1

# stop
set +e

for host in ${HOSTS[@]}; do
    echo "*** stop {{ item }} on $host"
    ssh "$host" "sudo systemctl stop {{ item }}"

    scp {{ item }} "$host:/srv/gallery/$ENV/{{ item }}/"

    echo "*** start {{ item }} on $host"
    ssh "$host" "sudo systemctl start {{ item }}"
done

set -e

echo

# restore
echo "*** build finish $(date)"
echo "==="

exec 1<&7 7<&-

echo "done."

exit 0;

